# Copy this file to ".env" and fill in your own token.
#   cp .env.example .env
#
# ONLY needed for the whisperX / pyannote engines (the gated ones).
# The default engines — faster-whisper+ECAPA, Parakeet, Sortformer — need NO token.
# Get a token at https://huggingface.co/settings/tokens (a classic "Read" token).
HF_ACCESS_TOKEN=
